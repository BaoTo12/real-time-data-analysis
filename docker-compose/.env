# ! Nó chỉ định ký tự phân tách (separator) giữa nhiều file Compose trong biến COMPOSE_FILE.
# Trên Linux/macOS, separator mặc định là dấu “:”.
#Trên Windows, separator mặc định là dấu “;”.
COMPOSE_PATH_SEPARATOR=:
# ! Nó cho phép Compose load nhiều file YAML cùng lúc, và gộp (merge) tất cả lại thành một cấu hình tổng thể.
# TODO: The order when we run docker compsoe up
# Đọc file common.yml
# Sau đó đọc kafka_cluster.yml
# Cuối cùng đọc services.yml
COMPOSE_FILE=common.yml:kafka_cluster.yml:services.yml
KAFKA_VERSION=7.3.15
ELASTIC_VERSION=8.19.5
SERVICE_VERSION=0.0.1-SNAPSHOT
GLOBAL_NETWORK=application
GROUP_ID=com.chibao.edu
